ENV=dev
DEBUG=false
DATABASE_URL=postgresql+asyncpg://cims:cims@localhost:5432/cims
TEST_DATABASE_URL=postgresql+asyncpg://cims:cims@localhost:5432/cims_test
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_HOURS=12
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173
# SMTP (leave SMTP_HOST empty to log emails instead of sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=cims@navy.mil.bd
SMTP_TLS=true
# BNPIMS procurement API (leave empty for mock data)
BNPIMS_BASE_URL=
BNPIMS_API_KEY=
# Seed
SEED_SUPERADMIN_USERNAME=admin
SEED_SUPERADMIN_EMAIL=admin@cims.local
SEED_SUPERADMIN_PHONE=01700000000
SEED_SUPERADMIN_PASSWORD=Admin@12345
